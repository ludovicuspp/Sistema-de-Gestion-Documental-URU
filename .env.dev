# Entorno de DESARROLLO versionado. Copiar a .env para ajustes locales:
#   cp .env.dev .env
# (.env esta ignorado por git; aqui van los valores canonicos.)
APP_ENV=dev
CORS_ORIGINS=*

POSTGRES_USER=sidae
POSTGRES_PASSWORD=sidae
POSTGRES_DB=sidae
POSTGRES_PORT=5433

# Solo desarrollo. En prod: secreto propio >= 32 bytes (obligatorio con APP_ENV=prod).
JWT_SECRET=dev-secret-change-me-please-32-bytes-minimum
JWT_EXPIRATION_MS=28800000

ADMIN_EMAIL=admin@uru.edu.ve
ADMIN_PASSWORD=Admin123!

MAIL_FROM=no-reply@uru.edu.ve
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025

# Almacenamiento de documentos: local (volumen) o s3.
# Para probar S3 en dev: STORAGE_BACKEND=s3 y levantar con --profile s3.
STORAGE_BACKEND=local
LOCALSTACK_PORT=4566
STORAGE_S3_ENDPOINT=http://localstack:4566
STORAGE_S3_BUCKET=sidae-documents
STORAGE_S3_ACCESS_KEY=test
STORAGE_S3_SECRET_KEY=test

# Puertos publicados en el host
FRONT_PORT=8080
FRONT_HTTPS_PORT=8443
AUTH_PORT=8081
CATALOG_PORT=8082
STUDENTS_PORT=8083
RECORDS_PORT=8084
REQUESTS_PORT=8085
TASKS_PORT=8086
REPORTS_PORT=8087
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
LOCALSTACK_PORT=4566

IMAGE_TAG=latest
BACKUP_KEEP=7
FRONT_URL=http://localhost:8080
