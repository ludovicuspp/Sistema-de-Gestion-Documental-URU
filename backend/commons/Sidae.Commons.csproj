<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- Biblioteca compartida: usar SDK Web para referencias completas de ASP.NET Core (p. ej. AddRateLimiter). -->
    <IsAspNetCoreApp>false</IsAspNetCoreApp>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.21.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(OutputPath)Sidae.Commons.dll" DestinationFolder="..\authentication\Sidae.Authentication\Binaries" />
    <Copy SourceFiles="$(OutputPath)Sidae.Commons.dll" DestinationFolder="..\support\Sidae.Support\Binaries" />
    <Copy SourceFiles="$(OutputPath)Sidae.Commons.dll" DestinationFolder="..\documents\Sidae.Documents\Binaries" />
    <Copy SourceFiles="$(OutputPath)Sidae.Commons.dll" DestinationFolder="..\security\Sidae.Security\Binaries" />
    <Copy SourceFiles="$(OutputPath)Sidae.Commons.dll" DestinationFolder="..\sidae\Sidae.Sidae\Binaries" />
  </Target>
</Project>
