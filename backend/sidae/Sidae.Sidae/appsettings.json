{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Enabled": true,
    "ClientPartitionHeader": null,
    "PermitLimitPerMinute": 100,
    "SlidingSegments": 4,
    "SlidingWindowQueueLimit": 0,
    "GlobalConcurrencyPermitLimit": 50,
    "GlobalConcurrencyQueueLimit": 20,
    "ExemptPathPrefixes": [ "/health", "/openapi", "/swagger", "/scalar" ]
  },
  "BusinessRateLimiting": {
    "Enabled": true,
    "PlanClaimType": "plan",
    "DefaultPlan": "free",
    "FallbackPermitsPerMinute": 60,
    "ApiKeyHeaderName": "X-Api-Key",
    "UseApiKeyWhenPresent": true,
    "AnonymousPermitsPerMinute": 30,
    "ClientPartitionHeader": null,
    "PlanPermitsPerMinute": {
      "free": 60,
      "pro": 300,
      "enterprise": 1200
    },
    "ApiKeyPlanMap": {},
    "ExemptPathPrefixes": [ "/health", "/openapi", "/swagger", "/scalar" ]
  },
  "SQLServer": {
    "ConnectionString": "Host=localhost;Port=5432;Database=sidae_db;Username=postgres;Password=your_password",
    "UseNpgsql": true
  },
  "Jwt": {
    "Key": "CHANGE_THIS_DEV_KEY_MIN_32_CHARS",
    "Issuer": "sidae-authentication",
    "Audience": "sidae-services"
  },
  "CloudflareR2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "",
    "PublicBaseUrl": ""
  }
}
