# Plantilla de entorno de PRODUCCION. Copiar a .env.prod y completar TODOS los valores.
# Nunca commitear el .env.prod con secretos reales.
# Uso: docker compose --env-file .env.prod up -d --build
APP_ENV=prod
CORS_ORIGINS=https://sidae.uru.edu.ve

POSTGRES_USER=sidae
# Requerido: password fuerte exclusivo de prod.
POSTGRES_PASSWORD=CAMBIAR-password-fuerte
POSTGRES_DB=sidae
POSTGRES_PORT=5433

# Requerido: secreto propio >= 32 bytes (el arranque falla con el valor de ejemplo).
JWT_SECRET=CAMBIAR-secreto-aleatorio-de-al-menos-32-bytes
JWT_EXPIRATION_MS=28800000

ADMIN_EMAIL=admin@uru.edu.ve
# Requerido: se usa una sola vez para el bootstrap; rotar despues del primer login.
ADMIN_PASSWORD=CAMBIAR-password-inicial-admin

MAIL_FROM=no-reply@uru.edu.ve
MAIL_ENABLED=true
# Relay SMTP real (Mailpit es solo para dev).
MAIL_HOST=CAMBIAR-smtp.proveedor.com
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR-usuario-smtp
MAIL_PASSWORD=CAMBIAR-password-smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Documentos: s3 en prod (S3 real o compatible). El volumen local no escala.
STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT=CAMBIAR-https://s3.proveedor.com
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=sidae-documentos
STORAGE_S3_ACCESS_KEY=CAMBIAR-access-key
STORAGE_S3_SECRET_KEY=CAMBIAR-secret-key
STORAGE_S3_PATH_STYLE=false
# Si se usa S3 compatible propio en vez de AWS (p. ej. MinIO), definir estas y
# apuntar STORAGE_S3_ENDPOINT a el, con STORAGE_S3_PATH_STYLE=true.

# Puertos publicados en el host
FRONT_PORT=8080
FRONT_HTTPS_PORT=8443
AUTH_PORT=8081
CATALOG_PORT=8082
STUDENTS_PORT=8083
RECORDS_PORT=8084
REQUESTS_PORT=8085
TASKS_PORT=8086
REPORTS_PORT=8087
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Imagenes versionadas (ver workflow .github/workflows/ci.yml, tags dev-<sha>).
IMAGE_TAG=dev-XXXXXXX
BACKUP_KEEP=14

# URL publica (se usa en los enlaces de los correos).
FRONT_URL=https://sidae.uru.edu.ve

# Certificados TLS reales: copiar tls.crt/tls.key al volumen front_certs, p. ej.:
#   docker run --rm -v sidae_front_certs:/certs -v /ruta/a/certs:/src:ro alpine cp /src/tls.crt /src/tls.key /certs/
