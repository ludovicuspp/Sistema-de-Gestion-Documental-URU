# Copiar a .env y ajustar para desarrollo local.
POSTGRES_USER=sidae
POSTGRES_PASSWORD=sidae
POSTGRES_DB=sidae
POSTGRES_PORT=5433

# Debe tener al menos 32 caracteres. Cambiar en produccion.
JWT_SECRET=dev-secret-change-me-please-32-bytes-minimum
JWT_EXPIRATION_MS=28800000

# Administrador inicial (se crea al arrancar auth-service si no existe).
ADMIN_EMAIL=admin@uru.edu.ve
ADMIN_PASSWORD=Admin123!

MAIL_FROM=no-reply@uru.edu.ve
MAIL_ENABLED=true

# Puertos publicados en el host
FRONT_PORT=8080
AUTH_PORT=8081
CATALOG_PORT=8082
STUDENTS_PORT=8083
RECORDS_PORT=8084
REQUESTS_PORT=8085
TASKS_PORT=8086
REPORTS_PORT=8087
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
